# The worker-base target builds without copying anything from Plex.
ARG PLEX_IMAGE=scratch
ARG PCC_PANEL_IMAGE=plexconfigcontrol:local
FROM ${PCC_PANEL_IMAGE} AS worker-base

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends rsync util-linux \
    && rm -rf /var/lib/apt/lists/*
RUN printf '%s\n' '#!/bin/sh' 'runtime="${PCC_PLEX_RUNTIME:-/opt/pcc-plex}"' \
      'exec env LD_LIBRARY_PATH="$runtime/lib" "$runtime/Plex SQLite" "$@"' \
      > /usr/local/bin/pcc-plex-sqlite \
    && chmod 0755 /usr/local/bin/pcc-plex-sqlite

HEALTHCHECK NONE
ENTRYPOINT ["/usr/bin/setpriv", "--reuid=568", "--regid=568", "--clear-groups", "--inh-caps=+chown,+dac_override,+fowner,+fsetid", "--ambient-caps=+chown,+dac_override,+fowner,+fsetid", "--bounding-set=-setuid,-setgid,-setpcap", "--no-new-privs", "python", "-m", "plexconfigcontrol.worker_runtime"]

# The default target is still built locally with the exact installed Plex image.
FROM ${PLEX_IMAGE} AS plex
FROM worker-base AS worker-with-plex
COPY --from=plex /usr/lib/plexmediaserver/ /opt/pcc-plex/
RUN /usr/local/bin/pcc-plex-sqlite -version
