[Desktop Entry]
Type=Application
Name=PlexConfigControl Installer
Name[pl]=Zainstaluj PlexConfigControl
Comment=Open the TrueNAS installation wizard over SSH
Comment[pl]=Otwórz kreator instalacji na TrueNAS przez SSH
Icon=system-run
TryExec=/bin/bash
Exec=/bin/bash -c "if [ -n \\"\\$1\\" ]; then cd -- \\"\\$(dirname -- \\"\\$1\\")\\" && /bin/bash ./PlexConfigControl_macOS.command; status=\\$?; else echo 'Open this launcher from the extracted folder or run the SSH script from a terminal.'; status=1; fi; read -r -p 'Press Enter to close the window. '; exit \\$status" pcc %k
Terminal=true
Categories=System;
